{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "company-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "company-service-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "company-service-evidence"
    }
  ],
  "send_email": [
    {
      "name": "MAILOUT"
    }
  ],
  // M9: inbound bursts buffer here; the raw MIME goes to R2 first (queue
  // messages cap at 128KB, attachments exceed it). Consumer registered on
  // the queue points at this worker.
  "queues": {
    "producers": [{ "binding": "INBOUND_Q", "queue": "cs-inbound" }],
    "consumers": [
      { "queue": "cs-inbound", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }
    ]
  },
  // M9: one durable instance per follow-up; sleeps until due_at, then fires.
  // The */5 cron sweep stays as backstop — markFired's atomic claim means
  // whichever path fires first wins, the other no-ops.
  "workflows": [
    { "name": "case-workflow", "binding": "CASE_WORKFLOW", "class_name": "CaseWorkflow" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "EMAIL_DOMAIN": "agentmasterkey.com",
    "INBOUND_ADDRESS": "cases@agentmasterkey.com",
    "EMAIL_FROM": "Company Service <cases@agentmasterkey.com>",
    "SIM_MERCHANT_ENABLED": "true"
  }
}
