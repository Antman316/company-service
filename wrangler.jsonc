{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "company-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "company-service-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "company-service-evidence"
    }
  ],
  "send_email": [
    {
      "name": "MAILOUT"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "EMAIL_DOMAIN": "agentmasterkey.com",
    "INBOUND_ADDRESS": "cases@agentmasterkey.com",
    "EMAIL_FROM": "Company Service <cases@agentmasterkey.com>",
    "SIM_MERCHANT_ENABLED": "true"
  }
}
