{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "company-service-test",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "company-service-db-test",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "company-service-evidence-test"
    }
  ],
  "vars": {
    "ENVIRONMENT": "test",
    "EMAIL_DOMAIN": "case.company-service.test",
    "INBOUND_ADDRESS": "cases@case.company-service.test",
    "EMAIL_FROM": "Company Service <cases@case.company-service.test>",
    "SIM_MERCHANT_ENABLED": "true",
    // Unit-test placeholder only. Not a credential. Never copy into a live secret.
    "SECRET_KEY": "placeholder-not-a-secret"
  }
}
